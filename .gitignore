# =================================
# Root-level .gitignore for full-stack Quasar + Node
# =================================

# Node modules for frontend & backend
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
frontend/.quasar/

# Environment files
backend/.env
frontend/.env

# Log files
*.log

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Optional: npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: temporary files
*.tmp
*.temp
